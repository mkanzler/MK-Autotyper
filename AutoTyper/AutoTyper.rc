// Shared language-neutral icons avoid duplicating image data per locale.
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_AUTOTYPER ICON "AutoTyper.ico"
IDI_SMALL ICON "AutoTyper-Small.ico"
IDR_LICENSE RCDATA "../LICENSE"

// Consistent release identity for Explorer, diagnostics and signing tools.
1 VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MK AutoTyper\0"
            VALUE "FileVersion", "2.1.0.0\0"
            VALUE "InternalName", "MK-AutoTyper\0"
            VALUE "OriginalFilename", "MK-AutoTyper.exe\0"
            VALUE "ProductName", "MK AutoTyper\0"
            VALUE "ProductVersion", "2.1.0.0\0"
            VALUE "LegalCopyright", "Copyright (C) 2024-2026 Marcel Kanzler.\0"
            VALUE "Comments", "User-controlled typing of text and saved snippets.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

